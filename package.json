{
  "name": "gmt-server",
  "version": "0.1.0",
  "private": true,
  "description": "Render/stitch web pages to images using headless Chromium.",
  "engines": {
    "node": ">=16 <17"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "fastify": "^4.28.1",
    "playwright": "1.43.0",
    "sharp": "0.32.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "16.18.126",
    "tsx": "3.12.7",
    "typescript": "^5.7.3"
  }
}
